# Asked for on deploy (typebot-builder):
ADMIN_EMAIL=you@example.com
SMTP_HOST=smtp.resend.com
SMTP_USERNAME=resend
SMTP_PASSWORD=
NEXT_PUBLIC_SMTP_FROM="'Typebot' <typebot@example.com>"

# Set by the Blueprint: DATABASE_URL, ENCRYPTION_SEED, NEXTAUTH_URL,
# NEXT_PUBLIC_VIEWER_URL, SMTP_PORT=587, PORT=3000, NODE_OPTIONS.
#
# Optional, add on typebot-builder after deploy:
# DISABLE_SIGNUP=true                 # after your admin account exists
# SMTP_SECURE=true                    # with SMTP_PORT=465
# GITHUB_CLIENT_ID= / GITHUB_CLIENT_SECRET=
# GOOGLE_AUTH_CLIENT_ID= / GOOGLE_AUTH_CLIENT_SECRET=
# S3_ACCESS_KEY= / S3_SECRET_KEY= / S3_BUCKET= / S3_ENDPOINT= / S3_REGION=
# REDIS_URL=                          # enables rate limiting (Render Key Value)
